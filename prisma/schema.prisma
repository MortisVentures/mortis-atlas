generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(cuid())
  name                String?
  email               String?             @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  isActive            Boolean             @default(true)
  lastLoginAt         DateTime?
  password            String?
  role                UserRole            @default(ANALYST)
  // Two-Factor Authentication
  twoFactorEnabled    Boolean             @default(false)
  twoFactorSecret     String?             // Encrypted TOTP secret
  twoFactorVerifiedAt DateTime?           // When 2FA was verified/enabled
  backupCodes         String[]            // Encrypted backup codes for recovery
  accounts            Account[]
  activities          Activity[]
  emailAccounts       EmailAccount[]
  calendarAccounts    CalendarAccount[]
  auditLogs           AuditLog[]
  companies           Company[]
  contacts            Contact[]
  deals               Deal[]
  dealTeamMemberships DealTeamMember[]
  documents           Document[]
  documentAccessLogs  DocumentAccessLog[]
  documentVersions    DocumentVersion[]
  icMemos             ICMemo[]
  icMemoVotes         ICMemoVote[]
  lpProfile           LPProfile?
  sessions            Session[]

  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id                String       @id @default(cuid())
  name              String
  website           String?
  description       String?
  stage             CompanyStage @default(PROSPECT)
  sector            String?
  location          String?
  foundedYear       Int?
  employeeCount     String?
  linkedinUrl       String?
  logoUrl           String?
  notes             String?
  userId            String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  valuation         Decimal?     @db.Decimal(15, 2)
  fundingAmount     Decimal?     @db.Decimal(15, 2)
  fundingRound      String?
  twitterHandle     String?
  referrerContactId String?
  sourceChannel     String?
  sourceDetail      String?
  sourceType        DealSource?
  activities        Activity[]
  referrerContact   Contact?     @relation("CompanyReferrer", fields: [referrerContactId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags              CompanyTag[]
  contacts          Contact[]
  deals             Deal[]
  documents         Document[]
  icMemos           ICMemo[]
  calendarEvents    CalendarEvent[]
  calendarAttendees CalendarAttendee[]

  @@index([userId])
  @@index([stage])
  @@index([sector])
  @@index([sourceType])
  @@index([referrerContactId])
  @@index([name])
}

model Contact {
  id                     String     @id @default(cuid())
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  role                   String?
  linkedinUrl            String?
  notes                  String?
  isPrimary              Boolean    @default(false)
  userId                 String
  companyId              String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  lastReferralDate       DateTime?
  referralConversionRate Decimal?   @db.Decimal(5, 2)
  successfulReferrals    Int        @default(0)
  totalReferralsMade     Int        @default(0)
  activities             Activity[]
  referredCompanies      Company[]  @relation("CompanyReferrer")
  company                Company?   @relation(fields: [companyId], references: [id])
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals                  Deal[]     @relation("DealContact")
  referredDeals          Deal[]     @relation("DealReferrer")
  calendarAttendees      CalendarAttendee[]

  @@index([userId])
  @@index([companyId])
  @@index([email])
  @@index([lastName, firstName])
  @@index([totalReferralsMade])
}

model Deal {
  id                String           @id @default(cuid())
  dealName          String
  amount            Decimal?         @db.Decimal(15, 2)
  valuation         Decimal?         @db.Decimal(15, 2)
  stage             DealStage        @default(INITIAL_REVIEW)
  probability       Int?
  expectedClose     DateTime?
  actualClose       DateTime?
  notes             String?
  userId            String
  companyId         String
  contactId         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lastActivityDate  DateTime?
  lastStageChange   DateTime?
  ownershipTarget   Decimal?         @db.Decimal(5, 4)
  postMoneyVal      Decimal?         @db.Decimal(15, 2)
  priority          DealPriority     @default(MEDIUM)
  proRataRights     Boolean          @default(false)
  referralDate      DateTime?
  referrerContactId String?
  roundSize         Decimal?         @db.Decimal(15, 2)
  sourceChannel     String?
  sourceDetail      String?
  sourceType        DealSource?
  stageHistory      Json?
  activities        Activity[]
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact           Contact?         @relation("DealContact", fields: [contactId], references: [id])
  referrerContact   Contact?         @relation("DealReferrer", fields: [referrerContactId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers       DealTeamMember[]
  documents         Document[]
  icMemos           ICMemo[]
  calendarEvents    CalendarEvent[]

  @@index([userId])
  @@index([companyId])
  @@index([contactId])
  @@index([referrerContactId])
  @@index([stage])
  @@index([priority])
  @@index([sourceType])
  @@index([expectedClose])
  @@index([lastStageChange])
}

model DealTeamMember {
  id         String   @id @default(cuid())
  dealId     String
  userId     String
  role       TeamRole @default(SUPPORT)
  assignedAt DateTime @default(now())
  notes      String?
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([dealId])
  @@index([userId])
}

model Activity {
  id           String       @id @default(cuid())
  type         ActivityType
  subject      String
  description  String?
  activityDate DateTime     @default(now())
  dueDate      DateTime?
  completed    Boolean      @default(false)
  userId       String
  companyId    String?
  contactId    String?
  dealId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  company       Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact       Contact?        @relation(fields: [contactId], references: [id])
  deal          Deal?           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent?

  @@index([userId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([activityDate])
  @@index([type])
  @@index([dueDate])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String?
  category  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  companies CompanyTag[]
  documents DocumentTag[]

  @@index([category])
}

model CompanyTag {
  companyId  String
  tagId      String
  assignedAt DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@index([companyId])
  @@index([tagId])
}

model Document {
  id              String              @id @default(cuid())
  name            String
  originalName    String
  description     String?
  documentType    DocumentType        @default(REFERENCE)
  accessLevel     AccessLevel         @default(TEAM)
  fileUrl         String
  fileType        String
  fileSize        Int
  mimeType        String
  storagePath     String
  bucketName      String              @default("documents")
  currentVersion  Int                 @default(1)
  companyId       String?
  dealId          String?
  icMemoId        String?
  uploadedById    String
  shareLink       String?
  shareLinkExpiry DateTime?
  viewCount       Int                 @default(0)
  downloadCount   Int                 @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         Company?            @relation(fields: [companyId], references: [id])
  deal            Deal?               @relation(fields: [dealId], references: [id])
  icMemo          ICMemo?             @relation(fields: [icMemoId], references: [id])
  uploadedBy      User                @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  accessLogs      DocumentAccessLog[]
  tags            DocumentTag[]
  versions        DocumentVersion[]

  @@index([uploadedById])
  @@index([companyId])
  @@index([dealId])
  @@index([icMemoId])
  @@index([documentType])
  @@index([accessLevel])
  @@index([createdAt])
  @@index([name])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  versionNumber Int
  fileUrl       String
  fileSize      Int
  changeNotes   String?
  documentId    String
  uploadedById  String
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
}

model DocumentAccessLog {
  id         String         @id @default(cuid())
  action     DocumentAction
  ipAddress  String?
  userAgent  String?
  documentId String
  userId     String
  createdAt  DateTime       @default(now())
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model DocumentTag {
  documentId String
  tagId      String
  assignedAt DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model ICMemo {
  id              String       @id @default(cuid())
  title           String
  status          ICMemoStatus @default(DRAFT)
  companyId       String
  dealId          String?
  authorId        String
  votingDeadline  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  submittedAt     DateTime?

  // === Thesis Alignment ===
  focusArea       String?      // Space & Defense, Autonomous, etc.
  stage           String?      // Pre-Seed, Seed, Series A

  // === Scores (queryable) ===
  tripleUseScore         ScoreRating?
  wlcdiaScore            ScoreRating?
  expectedCostDecline    Decimal?     @db.Decimal(5, 2)
  teamScore              ScoreRating?
  founderTechRating      Int?         // 1-5
  founderBusinessRating  Int?         // 1-5
  founderDesignRating    Int?         // 1-5
  marketScore            ScoreRating?
  capitalEfficiencyScore ScoreRating?

  // === Market Sizing ===
  tam             Decimal?     @db.Decimal(15, 2)
  sam             Decimal?     @db.Decimal(15, 2)
  som             Decimal?     @db.Decimal(15, 2)

  // === Capital Metrics ===
  trlStage        Int?         // Technology Readiness Level 1-9
  monthlyBurn     Decimal?     @db.Decimal(15, 2)
  runwayMonths    Int?

  // === Financial Terms (Ask) ===
  askAmount       Decimal?     @db.Decimal(15, 2)
  askValuation    Decimal?     @db.Decimal(15, 2)

  // === Financial Terms (Proposed) ===
  preMoneyValuation  Decimal?  @db.Decimal(15, 2)
  postMoneyValuation Decimal?  @db.Decimal(15, 2)
  roundSize          Decimal?  @db.Decimal(15, 2)
  mortisInvestment   Decimal?  @db.Decimal(15, 2)
  mortisOwnership    Decimal?  @db.Decimal(5, 4)  // e.g., 0.1000 = 10%
  followOnReserve    Decimal?  @db.Decimal(15, 2)

  // === Projections ===
  projectedExitYears Int?
  targetExitLow      Decimal?  @db.Decimal(15, 2)
  targetExitHigh     Decimal?  @db.Decimal(15, 2)
  projectedMoicLow   Decimal?  @db.Decimal(5, 2)
  projectedMoicHigh  Decimal?  @db.Decimal(5, 2)

  // === Decision ===
  memoRecommendation ICMemoRecommendation?
  decisionRationale  String?
  finalDecision      ICMemoDecision?

  // === Narrative Content (JSON) ===
  content         Json?

  // === Relations ===
  documents       Document[]
  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal            Deal?        @relation(fields: [dealId], references: [id])
  votes           ICMemoVote[]

  @@index([authorId])
  @@index([companyId])
  @@index([dealId])
  @@index([status])
  @@index([memoRecommendation])
  @@index([finalDecision])
  @@index([focusArea])
}

model ICMemoVote {
  id        String   @id @default(cuid())
  vote      VoteType
  comment   String?
  icMemoId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  icMemo    ICMemo   @relation(fields: [icMemoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([icMemoId, userId])
  @@index([icMemoId])
  @@index([userId])
}

model LPProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  entityName            String?
  entityType            String?
  commitmentAmount      Decimal   @db.Decimal(15, 2)
  calledCapital         Decimal   @default(0) @db.Decimal(15, 2)
  distributions         Decimal   @default(0) @db.Decimal(15, 2)
  fundAccess            String[]
  quarterlyReportsEmail Boolean   @default(true)
  capitalCallsEmail     Boolean   @default(true)
  taxDocumentsEmail     Boolean   @default(true)
  accreditedInvestor    Boolean   @default(false)
  kycVerified           Boolean   @default(false)
  kycVerifiedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  action      AuditAction
  entityType  String
  entityId    String?
  description String?
  changes     Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  requestPath String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  PARTNER
  ANALYST
  LP
}

enum CompanyStage {
  PROSPECT
  QUALIFIED
  ENGAGED
  DUE_DILIGENCE
  PASSED
  PORTFOLIO
  EXITED
}

enum DealStage {
  INITIAL_REVIEW
  MEETING_SCHEDULED
  DEEP_DIVE
  PARTNER_REVIEW
  TERM_SHEET
  LEGAL_DILIGENCE
  CLOSED_WON
  CLOSED_LOST
}

enum DealSource {
  REFERRAL
  DIRECT_OUTREACH
  INBOUND
  CONFERENCE
  ACCELERATOR
  NETWORK
  PORTFOLIO
  INVESTOR_NETWORK
  OTHER
}

enum DealPriority {
  HIGH
  MEDIUM
  LOW
}

enum TeamRole {
  LEAD
  SUPPORT
  ADVISOR
  BOARD_OBSERVER
}

enum ActivityType {
  EMAIL
  CALL
  MEETING
  NOTE
  TASK
  DEAL_UPDATE
  INTRO
  DOCUMENT
}

enum DocumentType {
  PITCH_DECK
  FINANCIAL_MODEL
  IC_MEMO
  TERM_SHEET
  DD_REPORT
  BOARD_NOTES
  LEGAL
  REFERENCE
}

enum AccessLevel {
  PRIVATE
  TEAM
  IC_MEMBERS
  LP_ACCESSIBLE
}

enum DocumentAction {
  VIEW
  DOWNLOAD
  SHARE
  EDIT
  DELETE
}

enum ICMemoStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_VOTE
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VoteType {
  YES
  NO
  ABSTAIN
}

enum ScoreRating {
  STRONG
  MODERATE
  WEAK
  ADEQUATE
}

enum ICMemoRecommendation {
  INVEST
  PASS
  REVISIT
}

enum ICMemoDecision {
  APPROVED
  DECLINED
  DEFERRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CREATE
  READ
  UPDATE
  DELETE
  VIEW
  DOWNLOAD
  UPLOAD
  SHARE
  EXPORT
  ROLE_CHANGE
  PERMISSION_CHANGE
  USER_INVITE
  USER_DEACTIVATE
}

// =============================================================================
// CALENDAR INTEGRATION ENUMS
// =============================================================================

enum CalendarProvider {
  GOOGLE
  OFFICE365
}

enum MeetingType {
  INITIAL_PITCH
  DUE_DILIGENCE
  PARTNER_MEETING
  BOARD_MEETING
  FOLLOW_UP
  NETWORKING
  PORTFOLIO_CHECK_IN
  INVESTOR_UPDATE
  OTHER
}

enum RelationshipHeat {
  HOT       // Rising engagement
  WARM      // Stable engagement
  COOLING   // Declining engagement
  COLD      // No recent meetings
}

// =============================================================================
// EMAIL INTEGRATION MODELS
// =============================================================================

enum EmailProvider {
  GMAIL
  OFFICE365
}

enum UnknownSenderStatus {
  PENDING
  CREATED_CONTACT
  CREATED_COMPANY
  LINKED_EXISTING
  DISMISSED
}

model EmailAccount {
  id              String        @id @default(cuid())
  userId          String
  provider        EmailProvider
  email           String
  accessToken     String        // Encrypted
  refreshToken    String        // Encrypted
  tokenExpiry     DateTime
  lastSyncAt      DateTime?
  syncCursor      String?       // For incremental sync
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads         EmailThread[]

  @@unique([userId, email])
  @@index([userId])
  @@index([provider])
}

model EmailThread {
  id                String         @id @default(cuid())
  accountId         String
  externalId        String         // Gmail thread ID
  subject           String
  snippet           String?        // Preview text
  participantEmails String[]
  lastMessageAt     DateTime
  messageCount      Int            @default(1)
  isArchived        Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // CRM Links
  companyId         String?
  contactId         String?
  dealId            String?

  account           EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages          EmailMessage[]

  @@unique([accountId, externalId])
  @@index([accountId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([lastMessageAt])
}

model EmailMessage {
  id              String        @id @default(cuid())
  threadId        String
  externalId      String        // Gmail message ID
  fromEmail       String
  fromName        String?
  toEmails        String[]
  ccEmails        String[]
  subject         String
  bodyPreview     String?       // First 500 chars only (privacy)
  sentAt          DateTime
  isInbound       Boolean
  hasAttachments  Boolean       @default(false)
  createdAt       DateTime      @default(now())

  thread          EmailThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, externalId])
  @@index([threadId])
  @@index([fromEmail])
  @@index([sentAt])
}

model UnknownSender {
  id              String              @id @default(cuid())
  userId          String
  email           String
  name            String?             // From email header
  domain          String?             // Extracted from email
  firstSeenAt     DateTime            @default(now())
  lastSeenAt      DateTime
  messageCount    Int                 @default(1)
  threadCount     Int                 @default(1)
  score           Int                 @default(0)   // Priority score
  status          UnknownSenderStatus @default(PENDING)
  dismissedReason String?
  metadata        Json?               // Signature extraction: { title, phone, company, etc. }
  recentSubjects  String[]            // Last 3 email subjects
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Result of proposal action
  createdContactId String?
  createdCompanyId String?
  linkedContactId  String?

  @@unique([userId, email])
  @@index([userId, status, score])
  @@index([userId, status])
  @@index([domain])
}

// =============================================================================
// CALENDAR INTEGRATION MODELS
// =============================================================================

model CalendarAccount {
  id              String            @id @default(cuid())
  userId          String
  provider        CalendarProvider
  email           String
  accessToken     String            // Encrypted
  refreshToken    String            // Encrypted
  tokenExpiry     DateTime
  calendarId      String            @default("primary")
  lastSyncAt      DateTime?
  syncCursor      String?           // pageToken for incremental sync
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          CalendarEvent[]

  @@unique([userId, email])
  @@index([userId])
  @@index([provider])
}

model CalendarEvent {
  id              String            @id @default(cuid())
  accountId       String
  externalId      String            // Google Calendar event ID
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  location        String?
  meetingLink     String?           // Zoom/Meet link extracted from description
  attendeeEmails  String[]
  attendeeNames   Json?             // { email: name } mapping
  organizerEmail  String
  isAllDay        Boolean           @default(false)
  isRecurring     Boolean           @default(false)
  recurringEventId String?          // ID of parent recurring event
  status          String            @default("confirmed") // confirmed, tentative, cancelled

  // Auto-detected meeting classification
  detectedType    MeetingType?
  typeConfidence  Float?            // 0-1 confidence score

  // CRM Links
  companyId       String?
  dealId          String?
  activityId      String?           @unique  // One-to-one with Activity
  isAutoLinked    Boolean           @default(false)
  linkConfirmed   Boolean           @default(false)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  account         CalendarAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company         Company?          @relation(fields: [companyId], references: [id])
  deal            Deal?             @relation(fields: [dealId], references: [id])
  activity        Activity?         @relation(fields: [activityId], references: [id])
  attendees       CalendarAttendee[]
  prepBrief       MeetingPrepBrief?

  @@unique([accountId, externalId])
  @@index([accountId])
  @@index([startTime])
  @@index([companyId])
  @@index([dealId])
  @@index([detectedType])
  @@index([organizerEmail])
}

model CalendarAttendee {
  id              String            @id @default(cuid())
  eventId         String
  email           String
  name            String?
  responseStatus  String            @default("needsAction") // needsAction, declined, tentative, accepted
  isOrganizer     Boolean           @default(false)

  // CRM Links (resolved via attendee matching)
  contactId       String?
  companyId       String?

  event           CalendarEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact         Contact?          @relation(fields: [contactId], references: [id])
  company         Company?          @relation(fields: [companyId], references: [id])

  @@unique([eventId, email])
  @@index([eventId])
  @@index([email])
  @@index([contactId])
  @@index([companyId])
}

model MeetingPrepBrief {
  id              String            @id @default(cuid())
  eventId         String            @unique
  generatedAt     DateTime          @default(now())
  viewedAt        DateTime?

  // Context sections (generated from CRM data)
  dealContext     Json?             // stage, amount, team, recentActivities, nextMilestone
  companyContext  Json?             // sector, valuation, fundingRound, previousMeetingsCount
  attendeeProfiles Json?            // array of { name, role, company, linkedinUrl, interactionCount, lastInteraction }
  relationshipSignals Json?         // array of { type, label, value, sentiment }
  suggestedTalkingPoints String[]   // Based on deal stage
  openQuestions   String[]          // From previous notes/activities
  recentInteractions Json?          // Last 5 activities

  event           CalendarEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([generatedAt])
}

model RelationshipMetrics {
  id                    String            @id @default(cuid())
  userId                String
  entityType            String            // "company" | "contact"
  entityId              String

  // Meeting counts
  meetingsLast30d       Int               @default(0)
  meetingsLast90d       Int               @default(0)
  avgMeetingsPerMonth   Float             @default(0)
  daysSinceLastMeeting  Int?
  lastMeetingDate       DateTime?

  // Heat scoring
  heat                  RelationshipHeat  @default(COLD)
  heatScore             Int               @default(0)    // 0-100
  trendDirection        Float             @default(0)    // negative = declining, positive = rising

  // Totals
  totalMeetings         Int               @default(0)
  totalEmails           Int               @default(0)

  lastCalculatedAt      DateTime          @default(now())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@index([heat])
  @@index([heatScore])
}
