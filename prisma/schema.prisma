// Mortis Atlas - VC/Investment CRM Schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// NextAuth.js Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Relations
  accounts      Account[]
  sessions      Session[]
  companies     Company[]
  contacts      Contact[]
  deals         Deal[]
  activities    Activity[]

  // Document relations
  documents         Document[]
  documentVersions  DocumentVersion[]
  documentAccessLogs DocumentAccessLog[]

  // IC Memo relations
  icMemos       ICMemo[]
  icMemoVotes   ICMemoVote[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Core CRM Models
// ============================================

model Company {
  id              String        @id @default(cuid())
  name            String
  website         String?
  description     String?       @db.Text
  stage           CompanyStage  @default(PROSPECT)
  sector          String?       // e.g., "FinTech", "HealthTech", "SaaS"
  location        String?
  foundedYear     Int?
  employeeCount   String?       // e.g., "1-10", "11-50", "51-200"
  fundingRound    String?       // e.g., "Seed", "Series A", "Series B"
  fundingAmount   Decimal?      @db.Decimal(15, 2) // Total funding raised
  valuation       Decimal?      @db.Decimal(15, 2) // Current/latest company valuation
  linkedinUrl     String?
  twitterHandle   String?       // e.g., "@companyname"
  logoUrl         String?
  notes           String?       @db.Text

  // Ownership
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  contacts        Contact[]
  deals           Deal[]
  activities      Activity[]
  tags            CompanyTag[]
  documents       Document[]
  icMemos         ICMemo[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([stage])
  @@index([sector])
  @@index([name])
}

enum CompanyStage {
  PROSPECT        // Initial identification
  QUALIFIED       // Meets investment criteria
  ENGAGED         // Active conversations
  DUE_DILIGENCE   // Deep dive analysis
  PASSED          // Decided not to pursue
  PORTFOLIO       // Invested company
  EXITED          // Successfully exited
}

model Contact {
  id              String     @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  role            String?    // e.g., "CEO", "CTO", "Founder"
  linkedinUrl     String?
  notes           String?    @db.Text
  isPrimary       Boolean    @default(false) // Primary contact for company

  // Ownership
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Company relationship (optional - contact can exist without company)
  companyId       String?
  company         Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Relations
  activities      Activity[]
  deals           Deal[]     @relation("DealContact")

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([email])
  @@index([lastName, firstName])
}

model Deal {
  id              String     @id @default(cuid())
  dealName        String
  amount          Decimal?   @db.Decimal(15, 2) // Investment amount
  valuation       Decimal?   @db.Decimal(15, 2) // Company valuation
  stage           DealStage  @default(INITIAL_REVIEW)
  probability     Int?       // 0-100 likelihood of closing
  expectedClose   DateTime?
  actualClose     DateTime?
  notes           String?    @db.Text

  // Ownership
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Company relationship
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Primary contact for this deal
  contactId       String?
  contact         Contact?   @relation("DealContact", fields: [contactId], references: [id], onDelete: SetNull)

  // Relations
  activities      Activity[]
  documents       Document[]
  icMemos         ICMemo[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([contactId])
  @@index([stage])
  @@index([expectedClose])
}

enum DealStage {
  INITIAL_REVIEW    // First look at opportunity
  MEETING_SCHEDULED // Initial meeting set up
  DEEP_DIVE         // Detailed analysis
  PARTNER_REVIEW    // Internal partner discussion
  TERM_SHEET        // Terms being negotiated
  LEGAL_DILIGENCE   // Legal review
  CLOSED_WON        // Deal completed
  CLOSED_LOST       // Deal did not close
}

model Activity {
  id              String       @id @default(cuid())
  type            ActivityType
  subject         String
  description     String?      @db.Text
  activityDate    DateTime     @default(now())
  dueDate         DateTime?    // For tasks
  completed       Boolean      @default(false)

  // Ownership
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic relationships (activity can be linked to any/all)
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId          String?
  deal            Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([activityDate])
  @@index([type])
  @@index([dueDate])
}

enum ActivityType {
  EMAIL         // Email sent/received
  CALL          // Phone call
  MEETING       // In-person or video meeting
  NOTE          // General note
  TASK          // To-do item
  DEAL_UPDATE   // Deal stage change or update
  INTRO         // Introduction made
  DOCUMENT      // Document shared/received
}

// ============================================
// Tagging System
// ============================================

model Tag {
  id              String       @id @default(cuid())
  name            String       @unique
  color           String?      // Hex color for UI display
  category        String?      // e.g., "Sector", "Technology", "Geography", "Theme"

  // Relations
  companies       CompanyTag[]
  documents       DocumentTag[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([category])
}

model CompanyTag {
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tagId           String
  tag             Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedAt      DateTime     @default(now())

  @@id([companyId, tagId])
  @@index([companyId])
  @@index([tagId])
}

// ============================================
// Document Management Models
// ============================================

model Document {
  id              String           @id @default(cuid())
  name            String           // Display name
  originalName    String           // Original file name
  description     String?          @db.Text
  documentType    DocumentType     @default(REFERENCE)
  accessLevel     AccessLevel      @default(TEAM)

  // File info
  fileUrl         String           // Supabase storage URL
  fileType        String           // pdf, xlsx, docx, pptx, png, jpg
  fileSize        Int              // Size in bytes
  mimeType        String           // MIME type

  // Storage info
  storagePath     String           // Full path in Supabase storage
  bucketName      String           @default("documents")

  // Version control
  currentVersion  Int              @default(1)

  // Relations - polymorphic (can be linked to company, deal, or IC memo)
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  dealId          String?
  deal            Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)

  icMemoId        String?
  icMemo          ICMemo?          @relation(fields: [icMemoId], references: [id], onDelete: SetNull)

  // Ownership
  uploadedById    String
  uploadedBy      User             @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  // Sharing
  shareLink       String?          // Signed URL for sharing
  shareLinkExpiry DateTime?        // Expiration for share link

  // Activity tracking
  viewCount       Int              @default(0)
  downloadCount   Int              @default(0)
  lastViewedAt    DateTime?

  // Relations
  versions        DocumentVersion[]
  accessLogs      DocumentAccessLog[]
  tags            DocumentTag[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([uploadedById])
  @@index([companyId])
  @@index([dealId])
  @@index([icMemoId])
  @@index([documentType])
  @@index([accessLevel])
  @@index([createdAt])
  @@index([name])
}

enum DocumentType {
  PITCH_DECK        // Company presentation and pitch materials
  FINANCIAL_MODEL   // Financial projections and models
  IC_MEMO           // Investment committee memos
  TERM_SHEET        // Investment term sheets
  DD_REPORT         // Due diligence reports
  BOARD_NOTES       // Board meeting notes
  LEGAL             // Legal agreements and contracts
  REFERENCE         // Reference materials and other documents
}

enum AccessLevel {
  PRIVATE           // Uploader only
  TEAM              // All fund members
  IC_MEMBERS        // IC members only
  LP_ACCESSIBLE     // LPs can view
}

model DocumentVersion {
  id              String       @id @default(cuid())
  versionNumber   Int
  fileUrl         String       // URL to this version's file
  fileSize        Int          // Size in bytes
  changeNotes     String?      @db.Text

  // Document relationship
  documentId      String
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Uploader
  uploadedById    String
  uploadedBy      User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
}

model DocumentAccessLog {
  id              String             @id @default(cuid())
  action          DocumentAction
  ipAddress       String?
  userAgent       String?

  // Document relationship
  documentId      String
  document        Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // User who accessed
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime           @default(now())

  @@index([documentId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum DocumentAction {
  VIEW
  DOWNLOAD
  SHARE
  EDIT
  DELETE
}

model DocumentTag {
  documentId      String
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  tagId           String
  tag             Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedAt      DateTime     @default(now())

  @@id([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

// ============================================
// IC Memo Model (for Document references)
// ============================================

model ICMemo {
  id              String           @id @default(cuid())
  title           String
  status          ICMemoStatus     @default(DRAFT)
  recommendation  String?          // INVEST, PASS, MORE_INFO
  requestedAmount Decimal?         @db.Decimal(15, 2)
  proposedTerms   String?          @db.Text

  // Company relationship
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Deal relationship (optional)
  dealId          String?
  deal            Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // Author
  authorId        String
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Content sections stored as JSON
  content         Json?            // Structured content for sections

  // Voting
  votingDeadline  DateTime?
  votes           ICMemoVote[]

  // Relations
  documents       Document[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submittedAt     DateTime?        // When submitted for review

  @@index([authorId])
  @@index([companyId])
  @@index([dealId])
  @@index([status])
}

enum ICMemoStatus {
  DRAFT             // Being written
  SUBMITTED         // Submitted for review
  UNDER_REVIEW      // Being reviewed by IC
  PENDING_VOTE      // Voting in progress
  APPROVED          // Approved by IC
  REJECTED          // Rejected by IC
  WITHDRAWN         // Withdrawn by author
}

model ICMemoVote {
  id              String           @id @default(cuid())
  vote            VoteType
  comment         String?          @db.Text

  // IC Memo relationship
  icMemoId        String
  icMemo          ICMemo           @relation(fields: [icMemoId], references: [id], onDelete: Cascade)

  // Voter
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([icMemoId, userId])
  @@index([icMemoId])
  @@index([userId])
}

enum VoteType {
  YES
  NO
  ABSTAIN
}
