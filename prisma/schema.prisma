generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(cuid())
  name                String?
  email               String?             @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  isActive            Boolean             @default(true)
  lastLoginAt         DateTime?
  password            String?
  role                UserRole            @default(ANALYST)
  // Two-Factor Authentication
  twoFactorEnabled    Boolean             @default(false)
  twoFactorSecret     String?             // Encrypted TOTP secret
  twoFactorVerifiedAt DateTime?           // When 2FA was verified/enabled
  backupCodes         String[]            // Encrypted backup codes for recovery
  accounts            Account[]
  activities          Activity[]
  auditLogs           AuditLog[]
  companies           Company[]
  contacts            Contact[]
  deals               Deal[]
  dealTeamMemberships DealTeamMember[]
  documents           Document[]
  documentAccessLogs  DocumentAccessLog[]
  documentVersions    DocumentVersion[]
  icMemos             ICMemo[]
  icMemoVotes         ICMemoVote[]
  lpProfile           LPProfile?
  sessions            Session[]

  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id                String       @id @default(cuid())
  name              String
  website           String?
  description       String?
  stage             CompanyStage @default(PROSPECT)
  sector            String?
  location          String?
  foundedYear       Int?
  employeeCount     String?
  linkedinUrl       String?
  logoUrl           String?
  notes             String?
  userId            String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  valuation         Decimal?     @db.Decimal(15, 2)
  fundingAmount     Decimal?     @db.Decimal(15, 2)
  fundingRound      String?
  twitterHandle     String?
  referrerContactId String?
  sourceChannel     String?
  sourceDetail      String?
  sourceType        DealSource?
  activities        Activity[]
  referrerContact   Contact?     @relation("CompanyReferrer", fields: [referrerContactId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags              CompanyTag[]
  contacts          Contact[]
  deals             Deal[]
  documents         Document[]
  icMemos           ICMemo[]

  @@index([userId])
  @@index([stage])
  @@index([sector])
  @@index([sourceType])
  @@index([referrerContactId])
  @@index([name])
}

model Contact {
  id                     String     @id @default(cuid())
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  role                   String?
  linkedinUrl            String?
  notes                  String?
  isPrimary              Boolean    @default(false)
  userId                 String
  companyId              String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  lastReferralDate       DateTime?
  referralConversionRate Decimal?   @db.Decimal(5, 2)
  successfulReferrals    Int        @default(0)
  totalReferralsMade     Int        @default(0)
  activities             Activity[]
  referredCompanies      Company[]  @relation("CompanyReferrer")
  company                Company?   @relation(fields: [companyId], references: [id])
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals                  Deal[]     @relation("DealContact")
  referredDeals          Deal[]     @relation("DealReferrer")

  @@index([userId])
  @@index([companyId])
  @@index([email])
  @@index([lastName, firstName])
  @@index([totalReferralsMade])
}

model Deal {
  id                String           @id @default(cuid())
  dealName          String
  amount            Decimal?         @db.Decimal(15, 2)
  valuation         Decimal?         @db.Decimal(15, 2)
  stage             DealStage        @default(INITIAL_REVIEW)
  probability       Int?
  expectedClose     DateTime?
  actualClose       DateTime?
  notes             String?
  userId            String
  companyId         String
  contactId         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lastActivityDate  DateTime?
  lastStageChange   DateTime?
  ownershipTarget   Decimal?         @db.Decimal(5, 4)
  postMoneyVal      Decimal?         @db.Decimal(15, 2)
  priority          DealPriority     @default(MEDIUM)
  proRataRights     Boolean          @default(false)
  referralDate      DateTime?
  referrerContactId String?
  roundSize         Decimal?         @db.Decimal(15, 2)
  sourceChannel     String?
  sourceDetail      String?
  sourceType        DealSource?
  stageHistory      Json?
  activities        Activity[]
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact           Contact?         @relation("DealContact", fields: [contactId], references: [id])
  referrerContact   Contact?         @relation("DealReferrer", fields: [referrerContactId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers       DealTeamMember[]
  documents         Document[]
  icMemos           ICMemo[]

  @@index([userId])
  @@index([companyId])
  @@index([contactId])
  @@index([referrerContactId])
  @@index([stage])
  @@index([priority])
  @@index([sourceType])
  @@index([expectedClose])
  @@index([lastStageChange])
}

model DealTeamMember {
  id         String   @id @default(cuid())
  dealId     String
  userId     String
  role       TeamRole @default(SUPPORT)
  assignedAt DateTime @default(now())
  notes      String?
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([dealId])
  @@index([userId])
}

model Activity {
  id           String       @id @default(cuid())
  type         ActivityType
  subject      String
  description  String?
  activityDate DateTime     @default(now())
  dueDate      DateTime?
  completed    Boolean      @default(false)
  userId       String
  companyId    String?
  contactId    String?
  dealId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id])
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([activityDate])
  @@index([type])
  @@index([dueDate])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String?
  category  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  companies CompanyTag[]
  documents DocumentTag[]

  @@index([category])
}

model CompanyTag {
  companyId  String
  tagId      String
  assignedAt DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@index([companyId])
  @@index([tagId])
}

model Document {
  id              String              @id @default(cuid())
  name            String
  originalName    String
  description     String?
  documentType    DocumentType        @default(REFERENCE)
  accessLevel     AccessLevel         @default(TEAM)
  fileUrl         String
  fileType        String
  fileSize        Int
  mimeType        String
  storagePath     String
  bucketName      String              @default("documents")
  currentVersion  Int                 @default(1)
  companyId       String?
  dealId          String?
  icMemoId        String?
  uploadedById    String
  shareLink       String?
  shareLinkExpiry DateTime?
  viewCount       Int                 @default(0)
  downloadCount   Int                 @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         Company?            @relation(fields: [companyId], references: [id])
  deal            Deal?               @relation(fields: [dealId], references: [id])
  icMemo          ICMemo?             @relation(fields: [icMemoId], references: [id])
  uploadedBy      User                @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  accessLogs      DocumentAccessLog[]
  tags            DocumentTag[]
  versions        DocumentVersion[]

  @@index([uploadedById])
  @@index([companyId])
  @@index([dealId])
  @@index([icMemoId])
  @@index([documentType])
  @@index([accessLevel])
  @@index([createdAt])
  @@index([name])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  versionNumber Int
  fileUrl       String
  fileSize      Int
  changeNotes   String?
  documentId    String
  uploadedById  String
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
}

model DocumentAccessLog {
  id         String         @id @default(cuid())
  action     DocumentAction
  ipAddress  String?
  userAgent  String?
  documentId String
  userId     String
  createdAt  DateTime       @default(now())
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model DocumentTag {
  documentId String
  tagId      String
  assignedAt DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model ICMemo {
  id              String       @id @default(cuid())
  title           String
  status          ICMemoStatus @default(DRAFT)
  companyId       String
  dealId          String?
  authorId        String
  votingDeadline  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  submittedAt     DateTime?

  // === Thesis Alignment ===
  focusArea       String?      // Space & Defense, Autonomous, etc.
  stage           String?      // Pre-Seed, Seed, Series A

  // === Scores (queryable) ===
  tripleUseScore         ScoreRating?
  wlcdiaScore            ScoreRating?
  expectedCostDecline    Decimal?     @db.Decimal(5, 2)
  teamScore              ScoreRating?
  founderTechRating      Int?         // 1-5
  founderBusinessRating  Int?         // 1-5
  founderDesignRating    Int?         // 1-5
  marketScore            ScoreRating?
  capitalEfficiencyScore ScoreRating?

  // === Market Sizing ===
  tam             Decimal?     @db.Decimal(15, 2)
  sam             Decimal?     @db.Decimal(15, 2)
  som             Decimal?     @db.Decimal(15, 2)

  // === Capital Metrics ===
  trlStage        Int?         // Technology Readiness Level 1-9
  monthlyBurn     Decimal?     @db.Decimal(15, 2)
  runwayMonths    Int?

  // === Financial Terms (Ask) ===
  askAmount       Decimal?     @db.Decimal(15, 2)
  askValuation    Decimal?     @db.Decimal(15, 2)

  // === Financial Terms (Proposed) ===
  preMoneyValuation  Decimal?  @db.Decimal(15, 2)
  postMoneyValuation Decimal?  @db.Decimal(15, 2)
  roundSize          Decimal?  @db.Decimal(15, 2)
  mortisInvestment   Decimal?  @db.Decimal(15, 2)
  mortisOwnership    Decimal?  @db.Decimal(5, 4)  // e.g., 0.1000 = 10%
  followOnReserve    Decimal?  @db.Decimal(15, 2)

  // === Projections ===
  projectedExitYears Int?
  targetExitLow      Decimal?  @db.Decimal(15, 2)
  targetExitHigh     Decimal?  @db.Decimal(15, 2)
  projectedMoicLow   Decimal?  @db.Decimal(5, 2)
  projectedMoicHigh  Decimal?  @db.Decimal(5, 2)

  // === Decision ===
  memoRecommendation ICMemoRecommendation?
  decisionRationale  String?
  finalDecision      ICMemoDecision?

  // === Narrative Content (JSON) ===
  content         Json?

  // === Relations ===
  documents       Document[]
  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal            Deal?        @relation(fields: [dealId], references: [id])
  votes           ICMemoVote[]

  @@index([authorId])
  @@index([companyId])
  @@index([dealId])
  @@index([status])
  @@index([memoRecommendation])
  @@index([finalDecision])
  @@index([focusArea])
}

model ICMemoVote {
  id        String   @id @default(cuid())
  vote      VoteType
  comment   String?
  icMemoId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  icMemo    ICMemo   @relation(fields: [icMemoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([icMemoId, userId])
  @@index([icMemoId])
  @@index([userId])
}

model LPProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  entityName            String?
  entityType            String?
  commitmentAmount      Decimal   @db.Decimal(15, 2)
  calledCapital         Decimal   @default(0) @db.Decimal(15, 2)
  distributions         Decimal   @default(0) @db.Decimal(15, 2)
  fundAccess            String[]
  quarterlyReportsEmail Boolean   @default(true)
  capitalCallsEmail     Boolean   @default(true)
  taxDocumentsEmail     Boolean   @default(true)
  accreditedInvestor    Boolean   @default(false)
  kycVerified           Boolean   @default(false)
  kycVerifiedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  action      AuditAction
  entityType  String
  entityId    String?
  description String?
  changes     Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  requestPath String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  PARTNER
  ANALYST
  LP
}

enum CompanyStage {
  PROSPECT
  QUALIFIED
  ENGAGED
  DUE_DILIGENCE
  PASSED
  PORTFOLIO
  EXITED
}

enum DealStage {
  INITIAL_REVIEW
  MEETING_SCHEDULED
  DEEP_DIVE
  PARTNER_REVIEW
  TERM_SHEET
  LEGAL_DILIGENCE
  CLOSED_WON
  CLOSED_LOST
}

enum DealSource {
  REFERRAL
  DIRECT_OUTREACH
  INBOUND
  CONFERENCE
  ACCELERATOR
  NETWORK
  PORTFOLIO
  INVESTOR_NETWORK
  OTHER
}

enum DealPriority {
  HIGH
  MEDIUM
  LOW
}

enum TeamRole {
  LEAD
  SUPPORT
  ADVISOR
  BOARD_OBSERVER
}

enum ActivityType {
  EMAIL
  CALL
  MEETING
  NOTE
  TASK
  DEAL_UPDATE
  INTRO
  DOCUMENT
}

enum DocumentType {
  PITCH_DECK
  FINANCIAL_MODEL
  IC_MEMO
  TERM_SHEET
  DD_REPORT
  BOARD_NOTES
  LEGAL
  REFERENCE
}

enum AccessLevel {
  PRIVATE
  TEAM
  IC_MEMBERS
  LP_ACCESSIBLE
}

enum DocumentAction {
  VIEW
  DOWNLOAD
  SHARE
  EDIT
  DELETE
}

enum ICMemoStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_VOTE
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VoteType {
  YES
  NO
  ABSTAIN
}

enum ScoreRating {
  STRONG
  MODERATE
  WEAK
  ADEQUATE
}

enum ICMemoRecommendation {
  INVEST
  PASS
  REVISIT
}

enum ICMemoDecision {
  APPROVED
  DECLINED
  DEFERRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CREATE
  READ
  UPDATE
  DELETE
  VIEW
  DOWNLOAD
  UPLOAD
  SHARE
  EXPORT
  ROLE_CHANGE
  PERMISSION_CHANGE
  USER_INVITE
  USER_DEACTIVATE
}
